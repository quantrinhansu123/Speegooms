# Copy thành server/.env. Không commit file .env.
# API chỉ bind loopback. Trình duyệt gọi cùng origin với FE (Next rewrite /api).

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# memory | postgres | supabase
# memory chỉ để chạy local. Production bắt buộc postgres hoặc supabase.
DB_PROVIDER=memory

# postgres
# DATABASE_URL=postgresql://speego:password@127.0.0.1:5432/speego
# DATABASE_SSL=false

# supabase — service role chỉ ở server, không bao giờ đưa xuống FE
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# cloudinary — chỉ ở server; Settings → API Keys (cần quyền Upload / Master Admin)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_FOLDER=speego

# openssl rand -base64 32  (ít nhất 32 ký tự)
SESSION_SECRET=dev-only-session-secret-do-not-use-prod
CSRF_SECRET=dev-only-csrf-secret-do-not-use-prod!!

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Mật khẩu seed cho tài khoản demo. Production phải đổi trước khi chạy seed.
SEED_USER_PASSWORD=speego@demo
# true khi đứng sau reverse proxy không phải loopback (nginx). Mặc định chỉ tin loopback.
TRUST_PROXY=false
