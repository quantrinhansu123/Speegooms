{
  "name": "fe-speego",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "pnpm --filter @speego/server dev",
    "dev:stack": "pnpm --parallel --filter fe-speego --filter @speego/server dev",
    "test:api": "pnpm --filter @speego/server test",
    "typecheck:api": "pnpm --filter @speego/server typecheck",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check:reports": "node --experimental-strip-types --no-warnings src/services/reports/rules.check.ts",
    "check:flow": "node scripts/check-flow.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "check": "pnpm check:crm && pnpm check:ops && pnpm check:fulfillment && pnpm check:accounting && pnpm check:backoffice && pnpm check:metrics && pnpm check:reports && pnpm check:flow && pnpm check:ui",
    "check:backoffice": "node --experimental-strip-types --no-warnings src/services/backoffice/rules.check.ts",
    "check:fulfillment": "node --experimental-strip-types --no-warnings src/services/fulfillment/rules.check.ts",
    "check:accounting": "node --experimental-strip-types --no-warnings src/services/accounting/rules.check.ts",
    "check:ops": "node --experimental-strip-types --no-warnings src/services/ops/rules.check.ts",
    "check:crm": "node --experimental-strip-types --no-warnings src/services/crm/rules.check.ts",
    "check:metrics": "node --experimental-strip-types --no-warnings src/features/dashboard/metrics.check.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "@speego/shared": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.5.2"
}
